{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": "container",
  "height": 467,

  "data": {
    "url": "Data/employment_composition.csv"
  },

  "mark": "bar",

  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "title": "Industry Group"
    },

    "yOffset": {
      "field": "year"
    },

    "x": {
      "field": "employment_share",
      "type": "quantitative",
      "title": "Employment Share (%)"
    },

    "color": {
      "field": "year",
      "type": "nominal",
      "title": "Year"
    },

    "tooltip": [
      {"field": "year"},
      {"field": "category"},
      {"field": "employment_share", "format": ".2f", "title":"Employment Share (%)"}
    ]
  }
}