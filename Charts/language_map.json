{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": "container",
  "height": 320,

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "selectedYear",
      "value": 2021,
      "bind": {
        "input": "select",
        "options": [2011, 2016, 2021],
        "name": "Census year: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "Data/SA3_2021_AUST_GDA2020.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#999",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "Data/language_density_dots.csv"
      },

      "transform": [
        {
          "filter": "datum.Year == selectedYear"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 18,
        "opacity": 0.7,
        "color": "#4C78A8"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "Label",
            "title": "SA3 region"
          },
          {
            "field": "Code",
            "title": "SA3 code"
          },
          {
            "field": "Year",
            "title": "Census year"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "lon": 111,
            "lat": -43
          }
        ]
      },

      "mark": {
        "type": "circle",
        "size": 70,
        "color": "#4C78A8"
      },

      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "lon": 114,
            "lat": -43,
            "label": " 20,000 people speaking another language"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#333"
      },

      "encoding": {
        "longitude": {
          "field": "lon"
        },

        "latitude": {
          "field": "lat"
        },

        "text": {
          "field": "label"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}