{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": "container",
  "height": 600,

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "selectedYear",
      "value": 2021,
      "bind": {
        "input": "select",
        "options": [2011, 2016, 2021],
        "name": "Year: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "../Data/STE_2021_AUST_GDA2020.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f5f5f5",
        "stroke": "#bdbdbd",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "../Data/median_weekly_income.csv"
      },

      "transform": [
        {
          "calculate": "selectedYear == 2011 ? datum.Income2011 : selectedYear == 2016 ? datum.Income2016 : datum.Income2021",
          "as": "SelectedIncome"
        },
        {
          "calculate": "selectedYear",
          "as": "Year"
        },
        {
  "filter": "isValid(datum.SelectedIncome) && datum.SelectedIncome > 0 && isValid(datum.Longitude) && isValid(datum.Latitude) && isValid(datum.STE_NAME21) && datum.STE_NAME21 != '' && datum.STE_NAME21 != 'Other Territories'"
}
      ],

      "mark": {
        "type": "circle",
        "color": "#2878b5",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "SelectedIncome",
          "type": "quantitative",
          "title": "Median weekly family income ($)",
          "scale": {
            "range": [40, 900]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },

        "tooltip": [
          {
            "field": "STE_NAME21",
            "title": "State / territory"
          },
          {
            "field": "Year",
            "title": "Census year"
          },
          {
            "field": "SelectedIncome",
            "title": "Median weekly family income ($)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}