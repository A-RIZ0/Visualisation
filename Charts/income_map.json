
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": "container",
  "height": 600,

  "projection": {
  "type": "mercator",
  "scale": 350,
  "center": [134, -28]
},

  "params": [
    {
      "name": "selectedYear",
      "value": 2021,
      "bind": {
        "input": "select",
        "options": [2011, 2016, 2021],
        "name": "Year: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "../data/SA3_2021_AUST_GDA2020.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2021_AUST_GDA2020"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f5f5f5",
        "stroke": "#bdbdbd",
        "strokeWidth": 0.4
      }
    },

    {
      "data": {
        "url": "../data/median_weekly_income.csv"
      },

      "transform": [
        {
          "calculate": "selectedYear == 2011 ? datum.Income2011 : selectedYear == 2016 ? datum.Income2016 : datum.Income2021",
          "as": "SelectedIncome"
        },
        {
          "calculate": "selectedYear",
          "as": "Year"
        },
        {
          "filter": "isValid(datum.SelectedIncome) && isValid(datum.Longitude) && isValid(datum.Latitude)"
        }
        
      ],

      "mark": {
        "type": "circle",
        "color": "#2878b5",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 0.5
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "SelectedIncome",
          "type": "quantitative",
          "title": "Median weekly family income ($)",
          "scale": {
            "range": [10, 650]
          },
          "legend": {
    "orient": "bottom",
    "direction": "horizontal"
  }
        },

        "tooltip": [
          {
            "field": "SA3_NAME21",
            "title": "SA3"
          },
          {
            "field": "Year",
            "title": "Census year"
          },
          {
            "field": "SelectedIncome",
            "title": "Median weekly family income ($)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
