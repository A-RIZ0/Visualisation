{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": "container",
  "height": 451,

  "data": {
    "url": "Data/family_composition.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "FamilyType",
          "type": "nominal",
          "sort": "-x",
          "title": null
          
        },

        "x": {
          "field": "Change",
          "type": "quantitative",
          "title": "Change in Share (%), 2011-2021"
        },

        "color": {
          "condition": {
            "test": "datum.Change > 0",
            "value": "#59a14f"
          },
          "value": "#e15759"
        }
      }
    },

    {
      "mark": {
        "type": "rule",
        "color": "black",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 8,
        "align": "left",
        "fontSize": 11
      },
      "transform": [
        {
          "filter": "datum.Change >= 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "FamilyType",
          "type": "nominal"
        },
        "x": {
          "field": "Change",
          "type": "quantitative"
        },
        "text": {
          "field": "Change",
          "format": "+.1f"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 0,
        "align": "right",
        "fontSize": 11
      },
      "transform": [
        {
          "filter": "datum.Change < 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "FamilyType",
          "type": "nominal"
        },
        "x": {
          "field": "Change",
          "type": "quantitative"
        },
        "text": {
          "field": "Change",
          "format": "+.1f"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}